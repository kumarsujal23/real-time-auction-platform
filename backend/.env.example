ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://auction:auction@postgres:5432/auction_db
SYNC_DATABASE_URL=postgresql+psycopg2://auction:auction@postgres:5432/auction_db

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUCTION_EXPIRY_POLL_SECONDS=2

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

RUN_WORKER_IN_PROCESS=true
